# ─── Agora ────────────────────────────────────────────────────────────────────
# Required: found in Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=

# Required: found in Agora Console → your project → "App Certificate"
# Server-side only. Never expose this in client code.
NEXT_AGORA_APP_CERTIFICATE=

# UID the AI agent joins the channel with.
# - Must match the agentUid set in app/api/invite-agent/route.ts.
# - (Optional override) Defaults: to 123456 (via lib/agora.ts)
NEXT_PUBLIC_AGENT_UID=123456

# Optional BYOK examples:
# - Murf is now used for live TTS and requires a server-side API key.
# - MURF_VOICE_ID may be either a plain voice name like Anisha or a JSON object string.
# - If you use JSON like {"voice_id":"Anisha","style":"Conversation","model":"Falcon"},
# - the current Agora SDK wrapper uses voice_id and model. style is ignored by the wrapper.
# - AGORA_INTERACTION_LANGUAGE must be a supported BCP-47 tag such as en-IN, en-US, or hi-IN.
# AGORA_INTERACTION_LANGUAGE=en-IN
# MURF_API_KEY=
# MURF_VOICE_ID={"voice_id":"Anisha","style":"Conversation","model":"Falcon"}
# MURF_TTS_VOICE_ID=
# MURF_TTS_MODEL=
# MURF_TTS_LOCALE=
# MURF_TTS_BASE_URL=
# MURF_TTS_RATE=
# MURF_TTS_PITCH=
# MURF_TTS_SAMPLE_RATE=
# NEXT_LLM_URL=https://api.openai.com/v1/chat/completions
# NEXT_LLM_API_KEY=
# NEXT_ELEVENLABS_API_KEY=
# NEXT_ELEVENLABS_VOICE_ID=

# ─── Agent behavior ───────────────────────────────────────────────────────────
# Optional opening line override
# NEXT_AGENT_GREETING=Hi there! I'm Ada, your virtual assistant from Agora. How can I help?
